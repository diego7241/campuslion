    {
      "name": "PM-06 Crear curso valido (positivo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Responde en menos de 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "const j = pm.response.json();",
              "pm.test(\"Devuelve el curso creado con id\", () => {",
              "  pm.expect(j._id).to.be.a(\"number\");",
              "  pm.expect(j.name).to.eql(pm.collectionVariables.get(\"nombreCurso\"));",
              "});",
              "pm.collectionVariables.set(\"cursoId\", j._id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Nombre unico por ejecucion (la regla RF-02 impide duplicados)",
              "const sufijo = Date.now().toString(36).toUpperCase();",
              "pm.collectionVariables.set(\"nombreCurso\", \"Curso Postman \" + sufijo);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/courses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{nombreCurso}}\",\n  \"category\": \"Back-end\",\n  \"lessons\": [\n    {\n      \"name\": \"Introduccion al curso\",\n      \"youtubeUrl\": \"Fj3Zvf-N4bk\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
