  "item": [
    {
      "name": "PM-01 Listar cursos paginado (positivo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde en menos de 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "const j = pm.response.json();",
              "pm.test(\"Esquema: courses, totalElements, totalPages\", () => {",
              "  pm.expect(j).to.have.keys(\"courses\",\"totalElements\",\"totalPages\");",
              "  pm.expect(j.courses).to.be.an(\"array\");",
              "});",
              "pm.test(\"Respeta pageSize=2\", () => pm.expect(j.courses.length).to.be.at.most(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/courses?page=0&pageSize=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "pageSize",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "PM-02 Consultar curso por id existente (positivo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde en menos de 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "const j = pm.response.json();",
              "pm.test(\"Devuelve el id 1 con nombre y lecciones\", () => {",
              "  pm.expect(j._id).to.eql(1);",
              "  pm.expect(j.name).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(j.lessons).to.be.an(\"array\").and.not.empty;",
              "});",
              "pm.test(\"Categoria valida\", () => pm.expect([\"Front-end\",\"Back-end\"]).to.include(j.category));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/courses/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "courses",
            "1"
          ]
        }
      }
    },
