    {
      "name": "PM-05 Buscar por nombre (positivo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Responde en menos de 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "pm.test(\"Devuelve un arreglo con coincidencias\", () => {",
              "  const j = pm.response.json();",
              "  pm.expect(j).to.be.an(\"array\").and.not.empty;",
              "  j.forEach(c => pm.expect(c.name.toLowerCase()).to.include(\"course\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/courses/searchByName?name=Course",
          "host": [
